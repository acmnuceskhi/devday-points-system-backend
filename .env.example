DATABASE_URL=postgresql://postgres:password@host:6543/postgres?pgbouncer=true
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=8h
FRONTEND_ORIGIN=http://localhost:5173
SIGNUP_VERIFY_BASE_URL=https://your-frontend.com/signup/verify
ALLOW_EMPTY_PASSWORD_LOGIN=true
SYSTEM_STAFF_PROFILE_ID=

# Email — option A: single Gmail account (fallback when SMTP_ACCOUNTS is not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=DevDay 2026

# Email — option B: multiple Gmail accounts for round-robin (overrides SMTP_USER/SMTP_PASS)
# Value must be a single-line JSON array string
SMTP_ACCOUNTS=[{"user":"acct1@gmail.com","pass":"app-pass-1","fromEmail":"acct1@gmail.com"},{"user":"acct2@gmail.com","pass":"app-pass-2","fromEmail":"acct2@gmail.com"}]

# AWS SES fallback (used if all SMTP accounts fail)
# Requires SES production access + ses:SendEmail permission on ECS task role
AWS_REGION=ap-south-1
SES_FROM_EMAIL=noreply@your-verified-domain.com
